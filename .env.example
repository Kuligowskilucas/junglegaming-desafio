HTTP_PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5433
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=2000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_MAX_RECEIVE_COUNT=10
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=300
SQS_SHUTDOWN_GRACE_MS=10000

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_WALLETS=20
OUTBOX_BATCH_EVENTS_PER_WALLET=50
OUTBOX_PUBLISH_TIMEOUT_MS=5000
REFERENCE_WORKER_ENABLED=true
REFERENCE_WORKER_POLL_INTERVAL_MS=1000
REFERENCE_WORKER_BATCH=50
WORKER_SHUTDOWN_GRACE_MS=10000

HEALTH_CHECK_TIMEOUT_MS=1000
