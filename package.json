{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "db:migrate": "bun ./node_modules/@mikro-orm/cli/cli.js migration:up",
    "db:migrate:down": "bun ./node_modules/@mikro-orm/cli/cli.js migration:down",
    "db:migration:create": "bun ./node_modules/@mikro-orm/cli/cli.js migration:create --blank",
    "db:migration:list": "bun ./node_modules/@mikro-orm/cli/cli.js migration:list"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/infrastructure/database/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1145.0",
    "@mikro-orm/core": "7.2.3",
    "@mikro-orm/migrations": "7.2.3",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.3",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.3",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  }
}
